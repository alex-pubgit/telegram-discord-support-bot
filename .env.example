# Copy to .env and edit. The simulator needs none of this.

# Knowledge base: a folder of Markdown files.
SUPPORTBOT_KB_DIR=sample_kb

# Answers: kb (quote the knowledge base) or rag-api (delegate to a service with POST /ask).
SUPPORTBOT_BACKEND=kb
# SUPPORTBOT_RAG_API_URL=http://127.0.0.1:8000

# Below this confidence (0-1) the bot hands off to a human instead of answering.
# SUPPORTBOT_MIN_CONFIDENCE=0.6

# Moderators, as platform:user_id, comma-separated.
SUPPORTBOT_ADMINS=

# Any long random string. Member ids in the analytics table are hashed with it. Required to run.
SUPPORTBOT_HASH_SALT=

# Tickets and analytics.
# SUPPORTBOT_DB=supportbot.sqlite3
# SUPPORTBOT_STORE_UNANSWERED=true

# Per-member rate limit: this many messages at once, then one per refill period.
# SUPPORTBOT_RATE_BURST=3
# SUPPORTBOT_RATE_REFILL_SECONDS=20

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATOR_CHAT_ID=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_MODERATOR_CHANNEL_ID=
